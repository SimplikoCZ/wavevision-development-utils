{
  "name": "simplikocz/development-utils",
  "type": "library",
  "license": "MIT",
  "description": "CLI tools for development",
  "authors": [
    {
      "name": "Wavevision s.r.o.",
      "email": "info@wavevision.com"
    },
    {
      "name": "Jakub Filla",
      "email": "jakub.filla@wavevision.cz"
    },
    {
      "name": "Vít Rozsíval",
      "email": "vit@wavevision.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Wavevision\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wavevision\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-utils.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-coding-standard.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "nette/neon": "^3.4",
    "wavevision/utils": "^3.0",
    "codedungeon/php-cli-colors": "^1.12",
    "vanilla/garden-cli": "^4.0"
  },
  "require-dev": {
    "wavevision/coding-standard": "^7.0",
    "phpunit/phpunit": "^11.1"
  },
  "bin": [
    "bin/create-database",
    "bin/drop-database",
    "bin/generate-constants",
    "bin/download-development",
    "bin/populate-database",
    "bin/setup-development"
  ],
  "extra": {
    "phpstan": {}
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
